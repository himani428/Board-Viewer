{
  "name": "figr-frontend-assignment",
  "private": true,
  "description": "Board viewer for a design tool (Figr frontend engineer assignment)",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node scripts/start.mjs",
    "backend": "node backend/server.js",
    "frontend": "vite frontend",
    "typecheck": "tsc --noEmit -p frontend",
    "build": "tsc --noEmit -p frontend && vite build frontend"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
